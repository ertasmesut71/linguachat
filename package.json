{
  "name": "linguachat",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered multilingual chat platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npx vite --host",
    "build": "cd client && npx vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/db/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "postinstall": "npx prisma generate --schema=server/db/prisma/schema.prisma || echo 'prisma generate skipped (ok for CI)'",
    "db:generate": "npx prisma generate --schema=server/db/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=server/db/prisma/schema.prisma",
    "db:migrate:prod": "npx prisma migrate deploy --schema=server/db/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=server/db/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=server/db/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema=server/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^8.55.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.14",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.33.5",
    "stripe": "^23.1.0",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^7.3.1"
  }
}
