# ═══════════════════════════════════════════════
# LinguaChat — Nginx Dockerfile (with built client)
#
# Multi-stage: builds the Vite client, then copies
# the production dist into nginx:alpine.
# No shared volumes needed — frontend assets are
# baked into the image.
# ═══════════════════════════════════════════════

# ─── Stage 1: Build client ───
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json ./
COPY client/package.json ./client/
RUN npm install --production=false
RUN cd client && npm install

COPY client/ ./client/
RUN cd client && npx vite build

# ─── Stage 2: Nginx with built client ───
FROM nginx:alpine

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy built client
COPY --from=builder /app/client/dist /usr/share/nginx/html

# Nginx config is mounted via docker-compose volume,
# but include a default copy for standalone use
# (docker-compose mount overrides this)
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
