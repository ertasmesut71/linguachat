# ─── LinguaChat Android Build Environment ───
# Copy to .env.production (or .env.local) before building for Android.
# These vars are embedded at Vite build time (VITE_ prefix required).

# Your production server URL (the Android app loads UI from bundled
# assets but needs to reach the API over the network).
VITE_API_URL=https://chat.yourdomain.com/api
VITE_WS_URL=wss://chat.yourdomain.com

# Google Contacts sync (same Client ID as web, but add Android SHA1 in Google Console)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
