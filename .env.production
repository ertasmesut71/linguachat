# ═══════════════════════════════════════════════
# LinguaChat — Production Environment
# Copy to .env and fill in real values
# ═══════════════════════════════════════════════

# ─── Auth (REQUIRED) ─────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ─── Your domain (for CORS) ─────────────────────
CLIENT_URL=https://yourdomain.com

# ─── Database (REQUIRED) ────────────────────────
# When using docker-compose.yml, this is auto-wired to the `postgres`
# service and does not need to be set here. For plain-Node deployments,
# set it to your managed Postgres instance.
# DATABASE_URL=postgresql://user:pass@host:5432/linguachat

# ─── Seeding ────────────────────────────────────
# Set to "true" on first deploy to seed demo accounts, then remove
SEED_ON_START=false

# ─── Translation & AI ───────────────────────────
# Leave empty for mock mode (translations return deterministic
# "[LANG] text" placeholders; AI features return safe mock results).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Speech-to-Text (optional) ──────────────────
# Without this, voice messages still work end-to-end (audio is stored
# and recipients can play it) but the text field is a clearly-labeled
# placeholder. Set one of these to wire real STT:
#   STT_PROVIDER=whisper   + OPENAI_API_KEY=sk-...
#   STT_PROVIDER=deepgram  + DEEPGRAM_API_KEY=...
STT_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# ─── Web Push (optional — VAPID keys for push notifications) ───
# Without these, push is disabled (the Profile page hides the toggle).
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@linguachat.local

# ─── Redis (optional — horizontal scaling) ─────────────
# Without REDIS_URL, the app uses an in-process EventEmitter for WS
# event fan-out — works perfectly for single-instance deployments.
# Set REDIS_URL to enable cross-instance message relay so multiple
# Node processes can serve WebSocket connections for the same users.
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@redis-host:6379/0
REDIS_URL=

# ─── Sentry (optional — error tracking) ────────────────
# Without SENTRY_DSN, error tracking is disabled (no-op, zero overhead).
# Set to your Sentry project DSN to capture unhandled server errors.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── SMS / OTP (optional — phone verification) ─────────
# SMS_PROVIDER controls how OTP codes are delivered.
#   "test"   — logs the code to console; returns it in the API response
#              when NODE_ENV ≠ production. No real SMS sent. Default.
#   "twilio" — sends real SMS via Twilio. Requires the 3 vars below.
SMS_PROVIDER=test
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567

# ─── Object storage (optional — leave blank for local FS) ───
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=linguachat
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=

# ─── SMTP (optional — password reset email delivery) ───
# Without SMTP_HOST set, the app logs reset emails to stdout instead
# of sending them. Safe default for dev; for production set all vars.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinguaChat <no-reply@yourdomain.com>

# ─── Port ───────────────────────────────────────
# This is the port the Node app listens on INSIDE its container.
# The public-facing port is controlled by docker-compose.yml's nginx
# service (defaults to 80). Do NOT set this to 80 — nginx already
# occupies that port in the bundled compose file.
PORT=4000

# ─── Google Contacts Sync (optional) ──────────────
# Google OAuth 2.0 Client ID. Without it, the Google Contacts tab
# is hidden and only manual phone import is available.
# Enable "People API" in your Google Cloud project.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Invite URL (optional) ──────────────────────
# VITE_INVITE_URL=https://linguachat.example/register
