# ─── Database (REQUIRED) ───
DATABASE_URL=postgresql://linguachat:linguachat@localhost:5432/linguachat

# ─── Server ───
PORT=4000
NODE_ENV=development

# ─── Auth ───
JWT_SECRET=replace-this-with-a-64-char-random-hex-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ─── Client ───
CLIENT_URL=http://localhost:5173

# ─── Translation & AI (Anthropic Claude API) ───
# Leave empty for mock mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Redis (optional — multi-instance WS scaling) ───
# Without this, WS events are relayed in-process (single-instance mode).
# Set to enable cross-instance message relay for horizontal scaling.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# ─── File/Audio Storage (S3, Cloudflare R2, or MinIO) ───
# Leave ALL blank to use local filesystem (server/data/uploads/)
# Set all four for cloud storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=linguachat
STORAGE_REGION=auto

# ─── SMTP (optional — password reset email delivery) ───
# Without SMTP_HOST set, reset emails are logged to stdout instead of sent.
# In non-production env, the API response also includes a `dev.token`
# field for local testing convenience.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinguaChat <no-reply@linguachat.local>

# ─── Web Push (optional — VAPID keys for push notifications) ───
# Without these, push notifications are disabled and the Profile page
# hides the push toggle. Generate a key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@linguachat.local

# ─── Sentry (optional — error tracking) ───
# Without SENTRY_DSN, error tracking is disabled (no-op).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0

# ─── SMS / OTP (optional — phone verification) ───
# "test" = log OTP to console, no real SMS. "twilio" = real SMS via Twilio.
SMS_PROVIDER=test
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── Google Contacts Sync (optional) ───
# Google OAuth 2.0 Client ID for contacts sync. Get one from
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable the "People API" in your Google Cloud project.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Invite URL (optional) ───
# Base URL for invitation links. Defaults to window.location.origin + /register
# VITE_INVITE_URL=https://linguachat.example/register
